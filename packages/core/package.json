{
  "name": "@paycheck-planner/core",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./money": {
      "types": "./src/money.ts",
      "import": "./src/money.ts"
    },
    "./currency": {
      "types": "./src/currency.ts",
      "import": "./src/currency.ts"
    },
    "./frequency": {
      "types": "./src/frequency.ts",
      "import": "./src/frequency.ts"
    },
    "./pay-period": {
      "types": "./src/payPeriod.ts",
      "import": "./src/payPeriod.ts"
    },
    "./tax-lines": {
      "types": "./src/taxLines.ts",
      "import": "./src/taxLines.ts"
    },
    "./history-engine": {
      "types": "./src/historyEngine.ts",
      "import": "./src/historyEngine.ts"
    },
    "./types": {
      "types": "./src/types.ts",
      "import": "./src/types.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest --config vitest.config.ts",
    "test:run": "vitest run --config vitest.config.ts",
    "sync-version": "node ../../scripts/sync-version.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@typescript-eslint/eslint-plugin": "^8.46.4",
    "@typescript-eslint/parser": "^8.46.4",
    "eslint": "^9.39.1",
    "typescript": "~5.9.3",
    "vitest": "^4.1.7"
  }
}
