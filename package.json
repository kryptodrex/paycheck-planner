{
  "name": "paycheck-planner-workspace",
  "private": true,
  "version": "0.5.0",
  "description": "Monorepo workspace for Paycheck Planner apps and packages.",
  "type": "module",
  "packageManager": "pnpm@10.13.1",
  "scripts": {
    "dev": "npx turbo run dev --filter=@paycheck-planner/desktop",
    "dev:inspector": "npx turbo run dev:inspector --filter=@paycheck-planner/desktop",
    "build": "npx turbo run build --filter=@paycheck-planner/desktop",
    "build:dir": "npx turbo run build:dir --filter=@paycheck-planner/desktop",
    "build:mac": "npx turbo run build:mac --filter=@paycheck-planner/desktop",
    "build:win": "npx turbo run build:win --filter=@paycheck-planner/desktop",
    "build:linux": "npx turbo run build:linux --filter=@paycheck-planner/desktop",
    "build:all": "npx turbo run build:all --filter=@paycheck-planner/desktop",
    "lint": "npx turbo run lint --filter=@paycheck-planner/desktop",
    "typecheck": "npx turbo run typecheck --filter=@paycheck-planner/desktop",
    "test": "npx turbo run test --filter=@paycheck-planner/desktop",
    "test:run": "npx turbo run test:run --filter=@paycheck-planner/desktop",
    "preview": "npx turbo run preview --filter=@paycheck-planner/desktop",
    "start": "npx turbo run start --filter=@paycheck-planner/desktop",
    "sync-version": "npx turbo run sync-version --filter=@paycheck-planner/desktop",
    "generate-icons": "npx turbo run generate-icons --filter=@paycheck-planner/desktop",
    "release-checks": "npx turbo run release-checks --filter=@paycheck-planner/desktop",
    "ws:dev": "npx turbo run dev",
    "ws:build": "npx turbo run build",
    "ws:lint": "npx turbo run lint",
    "ws:typecheck": "npx turbo run typecheck",
    "ws:test:run": "npx turbo run test:run",
    "ws:release-checks": "npx turbo run release-checks",
    "dev:desktop": "npx turbo run dev --filter=@paycheck-planner/desktop",
    "build:desktop": "npx turbo run build --filter=@paycheck-planner/desktop",
    "lint:desktop": "npx turbo run lint --filter=@paycheck-planner/desktop",
    "typecheck:desktop": "npx turbo run typecheck --filter=@paycheck-planner/desktop",
    "test:run:desktop": "npx turbo run test:run --filter=@paycheck-planner/desktop"
  },
  "devDependencies": {
    "turbo": "^2.5.0"
  }
}
