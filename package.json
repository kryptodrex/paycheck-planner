{
  "name": "paycheck-planner-workspace",
  "private": true,
  "version": "0.5.0",
  "description": "Monorepo workspace for Paycheck Planner apps and packages.",
  "type": "module",
  "packageManager": "pnpm@11.5.0",
  "engines": {
    "node": ">=22 <26",
    "pnpm": ">=10 <12"
  },
  "scripts": {
    "dev": "pnpm --config.minimumReleaseAge=0 --filter @paycheck-planner/desktop run dev",
    "dev:inspector": "pnpm --config.minimumReleaseAge=0 --filter @paycheck-planner/desktop run dev:inspector",
    "build": "pnpm --config.minimumReleaseAge=0 turbo run build --filter=@paycheck-planner/desktop",
    "build:dir": "pnpm --config.minimumReleaseAge=0 turbo run build:dir --filter=@paycheck-planner/desktop",
    "build:mac": "pnpm --config.minimumReleaseAge=0 turbo run build:mac --filter=@paycheck-planner/desktop",
    "build:win": "pnpm --config.minimumReleaseAge=0 turbo run build:win --filter=@paycheck-planner/desktop",
    "build:linux": "pnpm --config.minimumReleaseAge=0 turbo run build:linux --filter=@paycheck-planner/desktop",
    "build:all": "pnpm --config.minimumReleaseAge=0 turbo run build:all --filter=@paycheck-planner/desktop",
    "lint": "pnpm --config.minimumReleaseAge=0 turbo run lint --filter=@paycheck-planner/desktop",
    "typecheck": "pnpm --config.minimumReleaseAge=0 turbo run typecheck --filter=@paycheck-planner/desktop",
    "test": "pnpm --config.minimumReleaseAge=0 turbo run test --filter=@paycheck-planner/desktop",
    "test:run": "pnpm --config.minimumReleaseAge=0 turbo run test:run --filter=@paycheck-planner/desktop",
    "preview": "pnpm --config.minimumReleaseAge=0 turbo run preview --filter=@paycheck-planner/desktop",
    "start": "pnpm --config.minimumReleaseAge=0 turbo run start --filter=@paycheck-planner/desktop",
    "sync-version": "pnpm --config.minimumReleaseAge=0 turbo run sync-version --filter=@paycheck-planner/desktop",
    "generate-icons": "pnpm --config.minimumReleaseAge=0 turbo run generate-icons --filter=@paycheck-planner/desktop",
    "release-checks": "pnpm --config.minimumReleaseAge=0 turbo run release-checks --filter=@paycheck-planner/desktop",
    "ws:dev": "pnpm --config.minimumReleaseAge=0 turbo run dev",
    "ws:build": "pnpm --config.minimumReleaseAge=0 turbo run build",
    "ws:lint": "pnpm --config.minimumReleaseAge=0 turbo run lint",
    "ws:typecheck": "pnpm --config.minimumReleaseAge=0 turbo run typecheck",
    "ws:test:run": "pnpm --config.minimumReleaseAge=0 turbo run test:run",
    "ws:release-checks": "pnpm --config.minimumReleaseAge=0 turbo run release-checks",
    "dev:desktop": "pnpm --config.minimumReleaseAge=0 --filter @paycheck-planner/desktop run dev",
    "build:desktop": "pnpm --config.minimumReleaseAge=0 turbo run build --filter=@paycheck-planner/desktop",
    "lint:desktop": "pnpm --config.minimumReleaseAge=0 turbo run lint --filter=@paycheck-planner/desktop",
    "typecheck:desktop": "pnpm --config.minimumReleaseAge=0 turbo run typecheck --filter=@paycheck-planner/desktop",
    "test:run:desktop": "pnpm --config.minimumReleaseAge=0 turbo run test:run --filter=@paycheck-planner/desktop"
  },
  "devDependencies": {
    "turbo": "^2.5.0"
  }
}
