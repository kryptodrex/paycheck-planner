# API environment variables
# Copy this file to .env for local development.

# Runtime
NODE_ENV=development

# Upstream currency provider
CURRENCY_API_URL=https://api.frankfurter.app/latest
CURRENCY_REQUEST_TIMEOUT_MS=8000

# Auth
# Valid values: none | shared-secret
API_AUTH_MODE=none
# Set this when API_AUTH_MODE=shared-secret
API_SHARED_SECRET=
# Fail closed when auth is required but misconfigured
API_REQUIRE_AUTH=false

# Rate limiting
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX_REQUESTS=120

# Storage backend (currently only memory)
API_STORAGE_BACKEND=memory
