{
  "name": "@paycheck-planner/desktop",
  "private": true,
  "version": "1.0.0",
  "description": "Desktop paycheck planning and budget management application.",
  "author": {
    "name": "Paycheck Planner",
    "email": "paycheckplannersupport@gmail.com"
  },
  "license": "MIT",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "postinstall": "electron-rebuild || true",
    "sync-version": "node ../../scripts/sync-version.mjs",
    "generate-icons": "node scripts/generate-icons.js",
    "typecheck": "tsc -b",
    "start": "open ../../release/mac-arm64/Paycheck\\ Planner.app",
    "dev": "pnpm run sync-version && vite",
    "dev:inspector": "pnpm run sync-version && OPEN_DEVTOOLS=true vite",
    "build": "vite build && pnpm run sync-version",
    "release-checks": "pnpm run lint && tsc -b && pnpm run test:run && pnpm run build",
    "build:dir": "pnpm run sync-version && node scripts/generate-icons.js --if-present && tsc -b && vite build && electron-builder --dir",
    "build:mac": "pnpm run sync-version && node scripts/generate-icons.js --if-present && tsc -b && vite build && electron-builder --mac",
    "build:win": "pnpm run sync-version && node scripts/generate-icons.js --if-present && tsc -b && vite build && electron-builder --win",
    "build:linux": "pnpm run sync-version && node scripts/generate-icons.js --if-present && tsc -b && vite build && electron-builder --linux",
    "build:all": "pnpm run sync-version && node scripts/generate-icons.js --if-present && tsc -b && vite build && electron-builder --mac --win --linux",
    "rebuild-native": "electron-rebuild",
    "test": "vitest",
    "test:run": "vitest run",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "build": {
    "appId": "com.paycheckplanner.app",
    "productName": "Paycheck Planner",
    "afterSign": "scripts/notarize.mjs",
    "icon": "build/icon.png",
    "fileAssociations": [
      {
        "ext": "budget",
        "name": "Paycheck Planner Budget",
        "description": "Paycheck Planner budget file",
        "role": "Editor",
        "icon": "build/budget-file-icon"
      }
    ],
    "directories": {
      "output": "../../release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "mac": {
      "icon": "build/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.finance",
      "darkModeSupport": true,
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "gatekeeperAssess": true
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "icon": "build/icon.png",
      "maintainer": "Paycheck Planner <paycheckplannersupport@gmail.com>",
      "target": [
        "AppImage",
        "deb"
      ]
    }
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource/atkinson-hyperlegible": "^5.2.8",
    "@fontsource/opendyslexic": "^5.2.5",
    "@paycheck-planner/core": "workspace:*",
    "@paycheck-planner/storage": "workspace:*",
    "@paycheck-planner/platform-electron": "workspace:*",
    "keytar": "^7.9.0"
  },
  "devDependencies": {
    "@electron/notarize": "^3.1.1",
    "@electron/rebuild": "^4.0.3",
    "@eslint/js": "^9.39.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/crypto-js": "^4.2.2",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "^9.2.1",
    "crypto-js": "^4.2.0",
    "electron": "^41.7.1",
    "electron-builder": "^26.8.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jest-axe": "^10.0.0",
    "jsdom": "^29.0.0",
    "jspdf": "^4.2.0",
    "jspdf-autotable": "^5.0.7",
    "lucide-react": "^0.577.0",
    "png2icons": "^2.0.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vitest": "^4.1.0",
    "wait-on": "^9.0.4"
  }
}
