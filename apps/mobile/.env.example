# Mobile environment variables.
# Copy to `.env.local` for machine-specific overrides (git-ignored).
#
# Expo only exposes variables prefixed with EXPO_PUBLIC_ to the app bundle.
# Restart the Expo dev server after changing this file.

# Base URL of the Paycheck Planner API (glossary, app FAQs, currency rates).
# Falls back to `extra.apiBaseUrl` in app.json (the deployed URL) when unset.
#
# For local testing, run the API (`pnpm --filter @paycheck-planner/api dev`) and
# point this at it:
#   iOS simulator:    http://localhost:3000
#   Android emulator: http://10.0.2.2:3000
#   Physical device:  http://<your-machine-LAN-IP>:3000   (e.g. http://10.0.0.139:3000)
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000
